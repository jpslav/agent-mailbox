{
  "description": "Agent mailbox: tell the session its address and register its inbox socket with the local delivery daemon (started if needed); remove the registration when the session ends",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/mbox hook claude-code session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/mbox hook claude-code session-end"
          }
        ]
      }
    ]
  }
}
