# nats-server configuration for agent-mailbox (single server, file-backed JetStream).
# Copy to $MBOX_CONF_DIR/nats-server.conf next to the users.conf that server/mbox-admin.sh
# generates. Reference: https://docs.nats.io/running-a-nats-service/configuration
#
# Paths below are the LINUX defaults (config in /etc/agent-mailbox). On macOS with Homebrew the
# same three directories live under the Homebrew prefix (`brew --prefix`, /opt/homebrew on Apple
# Silicon):
#   MBOX_CONF_DIR  /etc/agent-mailbox        ->  <prefix>/etc/agent-mailbox
#   store_dir      /var/lib/agent-mailbox    ->  <prefix>/var/lib/nats
#   pid_file       /run/agent-mailbox/...    ->  <prefix>/var/run/agent-mailbox/nats-server.pid
# `sh server/install.sh` prints a copy command that fills in the right ones for this machine.

# Name shown in monitoring and client INFO.
server_name: "agent-mailbox"

# Client listener. Bind the mailbox host's tailnet address (Tailscale IPs look like 100.x.y.z), so
# only tailnet members can connect. "0.0.0.0:4222" also works, but ONLY on a machine whose port
# 4222 is not reachable from the internet or an untrusted LAN (check your firewall).
# Clients then use  nats://100.x.y.z:4222  (or the MagicDNS name, e.g. nats://mailbox-host.example.ts.net:4222).
listen: "100.x.y.z:4222"

# Monitoring endpoint (/varz, /jsz, /connz). Loopback only: it exposes connection details.
http: "127.0.0.1:8222"

# PID file (macOS: <prefix>/var/run/agent-mailbox/nats-server.pid). mbox-admin.sh reads it and sends
# the reload signal (nats-server --signal reload=<pid>) to that pid, so keep it on a line of its own.
pid_file: "/run/agent-mailbox/nats-server.pid"

# Largest message the server accepts, envelope included. The client refuses bigger messages with a
# clear error before sending.
max_payload: 1MB

# Clients that stop answering pings are dropped after ping_interval * ping_max.
ping_interval: "1m"
ping_max: 3

jetstream {
  # Where streams (all mail, presence) are stored (macOS: <prefix>/var/lib/nats). Back this
  # directory up (see README, "Backups").
  store_dir: "/var/lib/agent-mailbox"
  # Upper bound for all file storage on this server (each user stream is capped at 1 GiB by
  # mbox-admin.sh, so this also limits how many full mailboxes fit).
  max_file_store: 10GB
  # In-memory storage is not used by the mailbox.
  max_memory_store: 64MB
  # fsync every write before acknowledging it: a crash or power loss cannot lose acknowledged mail.
  # Mail volume is tiny, so the cost is irrelevant.
  sync_interval: always
}

# Accounts and users: the stream account MAILBOX (JetStream, every stream, the admin) and one
# account per mailbox user (their bcrypt password hash, imports from MAILBOX, permissions).
# GENERATED by server/mbox-admin.sh (init / add-user / remove-user); do not edit by hand.
include "users.conf"
